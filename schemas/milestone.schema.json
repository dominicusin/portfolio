{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "exit_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY",
        "ACTIVE",
        "BLOCKED",
        "DONE"
      ]
    },
    "exit_criteria": {
      "type": "string"
    }
  }
}
